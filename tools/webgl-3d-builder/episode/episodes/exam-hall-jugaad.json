  "lines": [
    {
      "speaker": "SharmaSir",
      "text": "सब लोग ध्यान से सुनो! आज का पेपर बहुत ज़रूरी है, और कोई नकल नहीं करेगा!",
      "emotion": "angry",
      "action": "pointing",
      "shot": "wideEstablishing",
      "sfx": "teacher_glare"
    },
    {
      "speaker": "Pappu",
      "to": "Golu",
      "text": "गोलू... तूने कुछ पढ़ा है क्या?",
      "emotion": "scared",
      "listenerEmotion": "calm",
      "shot": "twoShot"
    },
    {
      "speaker": "Golu",
      "to": "Pappu",
      "text": "हाँ, मैंने पूरी किताब पढ़ी है। और तूने?",
      "emotion": "proud",
      "shot": "closeUpSpeaker"
    },
    {
      "speaker": "Pappu",
      "to": "Golu",
      "text": "मैंने भी पूरी किताब... अपने मोज़े में छुपा ली है!",
      "emotion": "smug",
      "shot": "closeUpSpeaker"
    },
    {
      "speaker": "Golu",
      "to": "Pappu",
      "text": "क्या?! पकड़ा गया तो सीधा बाहर जाएगा!",
      "emotion": "surprised",
      "shot": "reactionZoom",
      "sfx": "gasp_break"
    },
    {
      "speaker": "SharmaSir",
      "text": "पेपर शुरू! तीन घंटे, और एक भी आवाज़ नहीं आनी चाहिए।",
      "emotion": "calm",
      "shot": "wideEstablishing",
      "spots": {
        "SharmaSir": "front_center"
      },
      "acts": {
        "Chintu": "deskSleep"
      },
      "pauseAfter": 0.9
    },
    {
      "speaker": "SharmaSir",
      "to": "Chintu",
      "text": "चिंटू! पेपर के ऊपर सो रहे हो?",
      "emotion": "angry",
      "action": "pointing",
      "shot": "crashPunch",
      "spots": {
        "SharmaSir": "aisle_r0_faceRight"
      },
      "sfx": "desk_thud"
    },
    {
      "speaker": "Chintu",
      "to": "SharmaSir",
      "text": "नहीं सर! मैं तो आँखें बंद करके सोच रहा था।",
      "emotion": "scared",
      "shot": "closeUpSpeaker",
      "acts": {
        "Chintu": null
      }
    },
    {
      "speaker": "SharmaSir",
      "to": "Chintu",
      "text": "अच्छा? सोचते सोचते खर्राटे भी ले रहे थे?",
      "emotion": "smug",
      "listenerEmotion": "scared",
      "shot": "twoShot",
      "pauseAfter": 0.7
    },
    {
      "speaker": "Pappu",
      "text": "बस एक पर्ची निकालता हूँ... धीरे से... किसी को पता नहीं चलेगा।",
      "emotion": "scared",
      "shot": "closeUpSpeaker",
      "acts": {
        "Chintu": "deskSleep"
      }
    },
    {
      "speaker": "SharmaSir",
      "to": "Pappu",
      "text": "पप्पू! हाथ में क्या है? दिखाओ!",
      "emotion": "angry",
      "action": "pointing",
      "shot": "crashPunch",
      "spots": {
        "SharmaSir": "aisle_r0_faceLeft"
      },
      "sfx": "shock_sting"
    },
    {
      "speaker": "Pappu",
      "to": "SharmaSir",
      "text": "क... कुछ नहीं सर... ये तो... रुमाल है!",
      "emotion": "scared",
      "shot": "closeUpSpeaker"
    },
    {
      "speaker": "SharmaSir",
      "to": "Pappu",
      "text": "रुमाल पर इतना कुछ लिखा है? चलो, इधर दो!",
      "emotion": "angry",
      "listenerEmotion": "scared",
      "shot": "twoShot",
      "pauseAfter": 0.6
    },
    {
      "speaker": "DubeyJi",
      "to": "SharmaSir",
      "text": "रुको! फ्लाइंग स्क्वॉड! यहाँ क्या चल रहा है?",
      "emotion": "angry",
      "shot": "lowDramatic",
      "spots": {
        "DubeyJi": "door_inside"
      },
      "sfx": "bell_sting"
    },
    {
      "speaker": "SharmaSir",
      "to": "DubeyJi",
      "text": "दुबे जी, ये लड़का नकल कर रहा था। ये देखिए, इसकी पर्ची!",
      "emotion": "angry",
      "action": "pointing",
      "shot": "closeUpSpeaker",
      "spots": {
        "DubeyJi": "front_center",
        "SharmaSir": "aisle_r0_faceFront"
      }
    },
    {
      "speaker": "DubeyJi",
      "to": "SharmaSir",
      "text": "आलू दो किलो, प्याज़ एक किलो, धनिया मुफ़्त में... ये कौन सा सवाल है?",
      "emotion": "confused",
      "shot": "closeUpSpeaker",
      "pauseAfter": 0.7
    },
    {
      "speaker": "SharmaSir",
      "to": "DubeyJi",
      "text": "अरे! ये तो मेरी पत्नी की सब्ज़ी वाली लिस्ट है! मेरी जेब से गिरी होगी!",
      "emotion": "surprised",
      "action": "slapForehead",
      "shot": "reactionZoom",
      "sfx": "gasp_break"
    },
    {
      "speaker": "Pappu",
      "to": "SharmaSir",
      "text": "देखा सर! मैंने कहा था ना, पर्ची मेरी नहीं है!",
      "emotion": "happy",
      "shot": "closeUpSpeaker",
      "spots": {
        "SharmaSir": "aisle_r0_faceLeft"
      }
    },
    {
      "speaker": "Golu",
      "to": "Pappu",
      "text": "लेकिन पप्पू, तूने आंसर शीट में भी आलू प्याज़ ही लिखा है!",
      "emotion": "laughing",
      "shot": "twoShot"
    },
    {
      "speaker": "DubeyJi",
      "to": "SharmaSir",
      "text": "हा हा हा! शर्मा जी, इसे सब्ज़ी मंडी भेज दो, वहाँ पक्का पास हो जाएगा!",
      "emotion": "laughing",
      "action": "laughing",
      "shot": "closeUpSpeaker",
      "sfx": "laugh_break",
      "pauseAfter": 0.8
    },
    {
      "speaker": "Chintu",
      "to": "SharmaSir",
      "text": "सर... पेपर कब शुरू होगा?",
      "emotion": "confused",
      "shot": "closeUpSpeaker",
      "acts": {
        "Chintu": null
      },
      "spots": {
        "SharmaSir": "aisle_r0_faceRight"
      }
    },
    {
      "speaker": "SharmaSir",
      "to": "Chintu",
      "text": "बेटा... पेपर ख़त्म हो गया!",
      "emotion": "angry",
      "action": "slapForehead",
      "shot": "wideEstablishing",
      "sfx": "break_whoosh"
    }
  ]
}