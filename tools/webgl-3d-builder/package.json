{
  "name": "animstudio-webgl-3d-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Bundles Three.js WebGL 3D animation engine into AnimStudio.Infrastructure embedded resources.",
  "scripts": {
    "build": "npm run build:batch && npm run build:motion",
    "build:batch": "esbuild src/main.ts --bundle --format=iife --minify --outfile=../../backend/AnimStudio.Infrastructure/Rendering/WebGl3D/scene-3d.bundle.js",
    "build:motion": "esbuild src/motion-stage.ts --bundle --format=esm --minify --outfile=../../frontend/src/app/features/motion-copy/motion-3d-stage.js"
  },
  "dependencies": {
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@types/three": "^0.175.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
