<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\AnimStudio.Application\AnimStudio.Application.csproj" />
    <ProjectReference Include="..\..\backend\AnimStudio.Infrastructure\AnimStudio.Infrastructure.csproj" />
    <!--
      For the admin authorization rule. It is the one piece of security logic that lives in
      the Api project, and "only a caller on this machine" is exactly the kind of rule that
      has to be asserted rather than assumed.
    -->
    <ProjectReference Include="..\..\backend\AnimStudio.Api\AnimStudio.Api.csproj" />
  </ItemGroup>

  <!-- Needed to construct an HttpContext for that rule. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>